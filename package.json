{
	"name": "mod-nodejs-skeleton",
	"version": "0.0.0",
	"description": "A Node.js-based module for AzerothCore that kept this default description from the skeleton project.",
	"scripts": {
		"build": "tsc --outdir ./.temp && esbuild ./.temp/index.js --bundle --platform=node --format=esm --sourcemap=linked --minify --outdir=./dist",
		"watch": "tsc --outdir ./out --watch"
	},
	"type": "module",
	"devDependencies": {
		"@airbreather/mod-nodejs-types": "^0.0.17",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
