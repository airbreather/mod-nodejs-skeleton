{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "preserve",
		"sourceMap": true,
		"inlineSources": true,
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"types": [
			"@airbreather/mod-nodejs-types",
			"@types/node",
			"long"
		],
		"resolveJsonModule": true,
		"strict": true,
		"noFallthroughCasesInSwitch": false,
		"isolatedModules": false,
		"skipLibCheck": true,
		"rewriteRelativeImportExtensions": true
	}
}
